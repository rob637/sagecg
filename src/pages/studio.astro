---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const companies = (await getCollection('portfolio')).sort(
  (a, b) => a.data.order - b.data.order
);
const inMarket = companies.filter((c) => c.data.status === 'active').length;
const hobbyCount = companies.filter((c) => c.data.status === 'hobby').length;

// The studio operating model, stage by stage.
const lifecycle = [
  {
    tag: '01',
    title: 'Thesis',
    body: 'We start from a specific, expensive problem where legacy incumbents rely on manual friction, guesswork, or bloated consulting.',
  },
  {
    tag: '02',
    title: 'Architecture',
    body: 'We prototype directly on our shared engineering spine — validating statutory rules, domain models, and unit economics before scaling.',
  },
  {
    tag: '03',
    title: 'Build & Operate',
    body: 'When a platform earns conviction, we ship it into production and operate it directly — we are the first operators, not passive investors.',
  },
  {
    tag: '04',
    title: 'In Market',
    body: 'A company stands on its own brand, domain, customers, and P&L. The shared studio spine stays underneath; the storefront is entirely its own.',
  },
];

const spine = [
  { label: 'Design & Craft', body: 'Shared typography, dark/light token architecture, and high-precision interfaces from day one.' },
  { label: 'Edge Engineering', body: 'Cloudflare Pages, Workers, D1, R2, and Firebase Gen 2 — zero-cold-start infrastructure shared across ventures.' },
  { label: 'Deterministic + AI Core', body: 'Bi-temporal statutory engines paired with Google Gemini & Anthropic Claude for auditable intelligence.' },
  { label: 'Back Office', body: 'Entity formation, legal, Stripe billing, compliance, and finance handled once for the entire portfolio.' },
];

const criteria = [
  { title: 'Real pain', body: 'A specific operator or customer is losing time or money to a broken workflow — and will pay to make it stop.' },
  { title: 'Fair market', body: 'Big enough to build a durable business, specialized enough that legacy giants move too slowly.' },
  { title: 'Operator edge', body: 'Deep domain expertise, proprietary regulatory synthesis, or technical leverage gives us an unfair head start.' },
  { title: 'Durable shape', body: 'High gross margins and a direct path to profitable, compounding cash flow — with zero outside capital.' },
];
---
<Layout
  title="The Studio — How SageCG Works"
  description="SageCG is a boutique venture studio, not a fund or a holding company. We pick hard problems, build software companies on a shared engineering spine, and operate them ourselves."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-[var(--color-rule)] bg-studio-grid">
    <div class="pointer-events-none absolute inset-0 bg-radial-fade"></div>
    <div class="relative mx-auto max-w-5xl px-6 pt-16 pb-14">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
        The Studio · Operating Model
      </p>
      <h1 class="mt-5 font-display text-5xl sm:text-6xl tracking-tight leading-[1.02] max-w-3xl">
        We don’t pick winners.<br />We engineer them.
      </h1>
      <p class="mt-7 text-lg text-[var(--color-ink)]/80 leading-relaxed max-w-2xl">
        A fund places bets. A holding company collects them. A venture studio
        <em class="font-display italic">builds</em> companies from the inside — on a shared spine of people,
        code, and infrastructure — and operates them for the long run.
      </p>
      <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-6 border-t border-[var(--color-rule)] pt-8">
        <div>
          <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-muted)]">Operating since</dt>
          <dd class="mt-1.5 font-display text-2xl sm:text-3xl">1998</dd>
        </div>
        <div>
          <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-muted)]">Commercial ventures</dt>
          <dd class="mt-1.5 font-display text-2xl sm:text-3xl">{inMarket} In Market</dd>
        </div>
        <div>
          <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-muted)]">Hobby builds</dt>
          <dd class="mt-1.5 font-display text-2xl sm:text-3xl">{hobbyCount} Active</dd>
        </div>
        <div>
          <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-muted)]">Outside capital</dt>
          <dd class="mt-1.5 font-display text-2xl sm:text-3xl">None</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Lifecycle -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
        The path · thesis to independence
      </p>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl tracking-tight">How a company gets built</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {lifecycle.map((s) => (
          <div class="relative rounded-2xl studio-panel p-6">
            <span class="font-mono text-xs font-medium tracking-[0.22em] text-[var(--color-accent)]">{s.tag}</span>
            <h3 class="mt-3 font-display text-xl tracking-tight">{s.title}</h3>
            <p class="mt-2.5 text-sm text-[var(--color-muted)] leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Shared spine -->
  <section class="border-b border-[var(--color-rule)] bg-[var(--color-surface-subtle)]">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-start">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-muted)]">The shared spine</p>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl tracking-tight">One studio underneath every brand</h2>
          <p class="mt-5 text-[var(--color-ink)]/80 leading-relaxed">
            Each company ships faster because it doesn’t rebuild the foundation. The studio is the spine;
            the companies are the body. Brands stay independent — the scaffolding does not.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {spine.map((s) => (
            <div class="rounded-2xl studio-panel p-5">
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-accent)]">{s.label}</p>
              <p class="mt-2 text-sm text-[var(--color-ink)]/85 leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Earns its keep -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
        What “earns its keep” means
      </p>
      <h2 class="mt-4 font-display text-3xl sm:text-4xl tracking-tight max-w-2xl">
        Every commercial venture clears four bars
      </h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {criteria.map((c, i) => (
          <div class="rounded-2xl studio-panel p-7">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-xs text-[var(--color-accent)]">0{i + 1}</span>
              <h3 class="font-display text-xl tracking-tight">{c.title}</h3>
            </div>
            <p class="mt-2.5 text-sm text-[var(--color-muted)] leading-relaxed">{c.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-[var(--color-muted)] leading-relaxed max-w-2xl">
        And when we build something purely for the love of our neighborhood or our annual football league, we label it honestly as a hobby project.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="mx-auto max-w-5xl px-6 py-16">
      <div class="rounded-2xl studio-panel p-8 sm:p-12">
        <h2 class="font-display text-3xl sm:text-4xl tracking-tight">See the spine at work</h2>
        <p class="mt-4 text-[var(--color-ink)]/80 leading-relaxed max-w-2xl">
          The portfolio is the proof. Browse the companies we’ve built and operate, or get in touch if you’re
          working on something adjacent.
        </p>
        <div class="mt-7 flex flex-wrap gap-4">
          <a
            href="/portfolio"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--color-ink)] px-6 py-3 text-sm font-medium text-[var(--color-paper)] hover:bg-[var(--color-accent)] hover:text-white transition-colors"
          >
            View the portfolio →
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--color-rule)] px-6 py-3 text-sm font-medium text-[var(--color-ink)] hover:border-[var(--color-ink)]/40 transition-colors"
          >
            Say hello
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
