---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('portfolio');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const statusLabel: Record<string, string> = {
  active: 'In Market',
  hobby: 'Hobby Project',
  building: 'In build',
  concept: 'Concept',
  archived: 'Archived',
};

// Related (everything else, max 3)
const others = (await getCollection('portfolio'))
  .filter((c) => c.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Only show meta fields that have values
const meta = [
  { label: 'Status', value: statusLabel[data.status] ?? data.status },
  data.stage ? { label: 'Stage', value: data.stage } : null,
  data.founded ? { label: 'Founded', value: data.founded } : null,
].filter(Boolean) as { label: string; value: string }[];

const pageUrl = `https://www.sagecg.com/portfolio/${entry.id}/`;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.sagecg.com/' },
    { '@type': 'ListItem', position: 2, name: 'Portfolio', item: 'https://www.sagecg.com/portfolio/' },
    { '@type': 'ListItem', position: 3, name: data.name, item: pageUrl },
  ],
};
const companyLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: data.legalName || data.name,
  alternateName: data.name,
  description: data.summary,
  url: data.url || pageUrl,
  parentOrganization: { '@id': 'https://www.sagecg.com/#organization' },
};
if (data.founded) companyLd.foundingDate = String(data.founded);

const softwareLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.name,
  applicationCategory: data.sector,
  operatingSystem: 'Web',
  description: data.summary,
  url: data.url || pageUrl,
  publisher: { '@id': 'https://www.sagecg.com/#organization' },
};
if (data.founded) softwareLd.datePublished = `${data.founded}-01-01`;
---
<Layout
  title={`${data.name} — SageCG Portfolio`}
  description={data.summary}
  ogImage={data.ogImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(companyLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(softwareLd)}></script>
  <article>
    <!-- Header -->
    <section class="relative overflow-hidden border-b border-[var(--color-rule)] bg-studio-grid">
      <div class="pointer-events-none absolute inset-0 bg-radial-fade"></div>
      <div class="relative mx-auto max-w-4xl px-6 pt-12 pb-14">
        <a
          href="/portfolio"
          class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors"
        >
          ← Back to Portfolio
        </a>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] border',
              data.status === 'active'
                ? 'border-emerald-500/25 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300'
                : data.status === 'hobby'
                ? 'border-amber-500/25 bg-amber-500/10 text-amber-800 dark:text-amber-300'
                : 'border-[var(--color-rule)] bg-[var(--color-surface-subtle)] text-[var(--color-muted)]',
            ]}
          >
            <span
              class="inline-block h-2 w-2 rounded-full"
              style={`background: ${data.accent ?? 'var(--color-accent)'}`}
            ></span>
            {statusLabel[data.status] ?? data.status}
          </span>
          <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-muted)]">
            {data.sector}
          </span>
        </div>

        <h1 class="mt-4 font-display text-5xl sm:text-6xl tracking-tight leading-[1.02]">{data.name}</h1>
        {data.legalName && data.legalName !== data.name && (
          <p class="mt-2 text-sm text-[var(--color-muted)] font-mono">{data.legalName}</p>
        )}

        <p class="mt-6 font-display text-2xl sm:text-3xl text-[var(--color-ink)]/85 italic max-w-2xl leading-snug">
          {data.tagline}
        </p>

        {(data.url || data.secondaryUrl) && (
          <div class="mt-7 flex flex-wrap items-center gap-3">
            {data.url && (
              <a
                href={data.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full bg-[var(--color-ink)] text-[var(--color-paper)] px-5 py-2.5 text-sm font-medium hover:bg-[var(--color-accent)] hover:text-white transition-all"
              >
                <span>Launch {new URL(data.url).hostname.replace('www.', '')}</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
            {data.secondaryUrl && (
              <a
                href={data.secondaryUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full studio-panel px-4 py-2.5 font-mono text-xs text-[var(--color-ink)]/80 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-all"
              >
                <span>{new URL(data.secondaryUrl).hostname.replace('www.', '')}{new URL(data.secondaryUrl).pathname !== '/' ? new URL(data.secondaryUrl).pathname : ''}</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        )}

        <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-6 border-t border-[var(--color-rule)] pt-8">
          {meta.map((m) => (
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-muted)]">{m.label}</dt>
              <dd class="mt-1.5 text-sm font-medium text-[var(--color-ink)]/90">{m.value}</dd>
            </div>
          ))}
          {data.stack && data.stack.length > 0 && (
            <div class="col-span-2 sm:col-span-1">
              <dt class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-muted)]">Core Stack</dt>
              <dd class="mt-1.5 text-sm font-medium text-[var(--color-ink)]/90">{data.stack.slice(0, 2).join(' · ')}</dd>
            </div>
          )}
        </dl>

        {data.metrics && data.metrics.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {data.metrics.map((metric) => (
              <span class="rounded-lg studio-panel px-3 py-1 font-mono text-[11px] text-[var(--color-ink)]/85">
                {metric}
              </span>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Body -->
    <section class="mx-auto max-w-3xl px-6 pt-14 pb-20">
      <div class="prose-content">
        <Content />
      </div>
    </section>
  </article>

  <!-- Related -->
  <section class="border-t border-[var(--color-rule)] bg-[var(--color-surface-subtle)]">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-muted)]">Also in the portfolio</p>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        {others.map((c) => (
          <a
            href={`/portfolio/${c.id}/`}
            class="studio-card group block rounded-xl p-5"
            style={`--card-accent: ${c.data.accent ?? 'var(--color-accent)'}`}
          >
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-display text-xl tracking-tight group-hover:text-[var(--color-accent)] transition-colors">{c.data.name}</h3>
              <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--color-muted)]">
                {statusLabel[c.data.status] ?? c.data.status}
              </span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">{c.data.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .prose-content {
    color: var(--color-ink);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .prose-content h2 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-content h2:first-child { margin-top: 0; }
  .prose-content h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .prose-content p { margin: 1rem 0; }
  .prose-content ul, .prose-content ol { margin: 1rem 0; padding-left: 1.25rem; }
  .prose-content ul { list-style: disc; }
  .prose-content ol { list-style: decimal; }
  .prose-content li { margin: 0.35rem 0; }
  .prose-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-rule);
  }
  .prose-content a:hover { text-decoration-color: var(--color-accent); }
  .prose-content strong { font-weight: 600; }
  .prose-content em { font-family: var(--font-serif); font-style: italic; }
</style>
