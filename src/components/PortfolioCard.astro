---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const { data } = entry;
const statusLabel: Record<string, string> = {
  active: 'In Market',
  hobby: 'Hobby Project',
  building: 'In build',
  concept: 'Concept',
  archived: 'Archived',
};

const isLive = data.status === 'active';
const isHobby = data.status === 'hobby';
const cleanDomain = data.url
  ? data.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')
  : null;
const cleanSecondary = data.secondaryUrl
  ? data.secondaryUrl.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')
  : null;
---
<article
  class="studio-card group relative flex flex-col justify-between rounded-2xl p-6 sm:p-7 overflow-hidden"
  style={`--card-accent: ${data.accent ?? 'var(--color-accent)'}`}
  data-status={data.status}
>
  <!-- Top accent bar -->
  <span
    class="pointer-events-none absolute inset-x-0 top-0 h-[3px] opacity-80 group-hover:opacity-100 transition-opacity"
    style="background: var(--card-accent)"
  ></span>

  <div>
    <!-- Top metadata row: sector & status pill -->
    <div class="flex items-center justify-between gap-3">
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-muted)] line-clamp-1">
        {data.sector}
      </span>
      <span
        class:list={[
          'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.16em] whitespace-nowrap border',
          isLive
            ? 'border-emerald-500/25 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300'
            : isHobby
            ? 'border-amber-500/25 bg-amber-500/10 text-amber-800 dark:text-amber-300'
            : 'border-[var(--color-rule)] bg-[var(--color-surface-subtle)] text-[var(--color-muted)]',
        ]}
      >
        <span
          class:list={[
            'h-1.5 w-1.5 rounded-full',
            isLive ? 'bg-emerald-500' : isHobby ? 'bg-amber-500' : 'bg-[var(--color-muted)]',
          ]}
        ></span>
        {statusLabel[data.status] ?? data.status}
      </span>
    </div>

    <!-- Title -->
    <div class="mt-3.5 flex items-baseline justify-between gap-3">
      <h3 class="font-display text-2xl sm:text-[1.65rem] tracking-tight leading-tight group-hover:text-[var(--color-accent)] transition-colors">
        <a href={`/portfolio/${entry.id}/`} class="after:absolute after:inset-0">
          {data.name}
        </a>
      </h3>
    </div>

    <!-- Live Domain Chips -->
    {(cleanDomain || cleanSecondary) && (
      <div class="relative z-10 mt-2 flex flex-wrap items-center gap-2">
        {cleanDomain && data.url && (
          <a
            href={data.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1 rounded-md studio-pill px-2 py-0.5 font-mono text-[10px] text-[var(--color-ink)]/75 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors"
          >
            <span class="truncate max-w-[210px]">{cleanDomain}</span>
            <span aria-hidden="true" class="opacity-60">↗</span>
          </a>
        )}
        {cleanSecondary && data.secondaryUrl && (
          <a
            href={data.secondaryUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1 rounded-md studio-pill px-2 py-0.5 font-mono text-[10px] text-[var(--color-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors"
          >
            <span class="truncate max-w-[180px]">{cleanSecondary}</span>
            <span aria-hidden="true" class="opacity-60">↗</span>
          </a>
        )}
      </div>
    )}

    <!-- Tagline -->
    <p class="mt-3.5 text-[15.5px] text-[var(--color-ink)]/90 italic font-display leading-snug">
      {data.tagline}
    </p>

    <!-- Summary -->
    <p class="mt-2.5 text-sm text-[var(--color-muted)] leading-relaxed">
      {data.summary}
    </p>

    <!-- Key Highlights / Metrics -->
    {data.metrics && data.metrics.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {data.metrics.map((metric) => (
          <span
            class="inline-flex items-center rounded-md px-2 py-0.5 font-mono text-[10px] tracking-tight border border-[var(--color-rule)] bg-[var(--color-surface-subtle)] text-[var(--color-ink)]/80"
          >
            {metric}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Card Footer -->
  <div class="mt-6 pt-4 border-t border-[var(--color-rule)] flex items-center justify-between gap-2 text-[11px] font-mono text-[var(--color-muted)]">
    <div class="flex items-center gap-2 truncate">
      {data.founded && <span>Est. {data.founded}</span>}
      {data.founded && data.stack && data.stack.length > 0 && <span class="opacity-40">·</span>}
      {data.stack && data.stack.length > 0 && (
        <span class="truncate text-[var(--color-muted)]/80">{data.stack.slice(0, 2).join(' · ')}</span>
      )}
    </div>
    <span class="inline-flex items-center gap-1 text-[var(--color-ink)]/80 group-hover:text-[var(--color-accent)] font-medium transition-colors shrink-0">
      Case study <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
    </span>
  </div>
</article>
